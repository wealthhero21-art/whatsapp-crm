# Reference list of every env var the backend reads in production.
# Paste these into Coolify → app → Environment Variables (one row per var).
# DO NOT commit a populated copy of this file.

# --- Database (from `create-app-db whatsapp-crm` on the server) ---
DATABASE_URL=postgres://whatsapp_crm:<password>@tod9m3eq8aady2f9ar6z8ciy:5432/whatsapp_crm

# --- WhatsApp env defaults (per-brand overrides live in the whatsapp_numbers table) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=                    # generate: openssl rand -hex 16
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- Default outbound templates ---
DOC_REREQUEST_TEMPLATE=doc_rerequest
DOC_REREQUEST_LANGUAGE=en

# --- OTP login over WhatsApp ---
OTP_TEMPLATE_NAME=login_otp
OTP_TEMPLATE_LANGUAGE=en
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- JWT ---
JWT_SECRET=                              # generate: openssl rand -hex 32
JWT_TTL_SECONDS=43200

# --- CORS ---
# Public domain Coolify routes here.
CORS_ORIGIN=https://crm.maximoney.in

# --- Backend ---
LOG_LEVEL=info

# --- Webhook delivery ---
WEBHOOK_DELIVERY_RETRIES=5

# --- Bootstrap admin (only used by db:seed; can be set once and forgotten) ---
BOOTSTRAP_ADMIN_PHONE=+91XXXXXXXXXX
BOOTSTRAP_ADMIN_NAME=Master Admin
