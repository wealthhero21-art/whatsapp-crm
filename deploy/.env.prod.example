# Production environment for docker-compose.prod.yml.
# Copy to .env.prod on the server (chmod 600) — DO NOT commit the real one.

# --- Domain / TLS ---
DOMAIN=crm.maximoney.in
ACME_EMAIL=admin@maximoney.in            # Let's Encrypt notifications

# --- GHCR image tag ---
# Set by GitHub Actions on each deploy. Leave latest for manual runs.
GHCR_REPO=<your-gh-user>/<your-gh-repo>
IMAGE_TAG=latest

# --- Postgres ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=                       # generate: openssl rand -hex 24
POSTGRES_DB=whatsapp_crm

# --- Backend ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=https://crm.maximoney.in

# DATABASE_URL + REDIS_URL are injected by compose (don't set them here)

# --- WhatsApp (env defaults; admin can add additional brand numbers in the UI) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=                    # generate: openssl rand -hex 16
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# --- OTP / JWT ---
OTP_TEMPLATE_NAME=login_otp
OTP_TEMPLATE_LANGUAGE=en
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
JWT_SECRET=                              # generate: openssl rand -hex 32
JWT_TTL_SECONDS=43200

# --- Storage (local disk on the server) ---
STORAGE_DRIVER=disk
DISK_STORAGE_PATH=/var/crm/docs

# --- Offsite backup target (Hetzner Storage Box, SFTP) ---
# Hetzner emails you these after subscribing to a Storage Box.
HETZNER_SB_HOST=uXXXXXX.your-storagebox.de
HETZNER_SB_USER=uXXXXXX
HETZNER_SB_PASSWORD=                     # one-time password from Hetzner Robot
HETZNER_SB_PORT=23                       # SFTP port (not 22)

# --- Webhook delivery ---
WEBHOOK_DELIVERY_RETRIES=5

# --- Bootstrap (used once by db:seed; can stay set after) ---
BOOTSTRAP_ADMIN_PHONE=+91XXXXXXXXXX
BOOTSTRAP_ADMIN_NAME=Master Admin
