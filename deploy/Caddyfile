# Internal Caddy — runs behind Coolify-Traefik (which terminates TLS).
# Listens on :8080 inside the docker network; Traefik routes the public
# domain to this container.
#
# Responsibilities:
#   - Serve the SPA static files (built into the image at /srv)
#   - Proxy /api/*, /auth/*, /webhook/*, /health to the backend container
#   - Disable buffering on the SSE stream
#   - Set security headers (HSTS handled by Traefik; the rest here)

{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	@api path /api/* /auth/* /webhook/* /health
	reverse_proxy @api backend:4000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# SSE stream — disable buffering, allow long reads
	@sse path /api/events
	reverse_proxy @sse backend:4000 {
		flush_interval -1
		transport http {
			read_timeout 24h
		}
	}

	# Frontend SPA fallback
	root * /srv
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}
}
