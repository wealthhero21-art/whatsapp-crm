# crm.maximoney.in  (Caddy auto-fetches Let's Encrypt certs on first request)
#
# Caddy serves the SPA, proxies all API/auth/webhook traffic to the backend
# container on the internal docker network, and forces HTTPS.
#
# DOMAIN is supplied at runtime via env in docker-compose.prod.yml.

{
	# Global options
	email {$ACME_EMAIL}
	# Use the production ACME endpoint by default. To test cert issuance
	# without burning Let's Encrypt rate limits, set ACME_CA=staging.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# Backend API + auth + Meta webhook
	@api path /api/* /auth/* /webhook/* /health
	reverse_proxy @api backend:4000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# SSE stream — disable buffering, raise timeouts
	@sse path /api/events
	reverse_proxy @sse backend:4000 {
		flush_interval -1
		transport http {
			read_timeout 24h
		}
	}

	# Everything else is the SPA. fallback to /index.html for client-side routing.
	root * /srv
	try_files {path} /index.html
	file_server

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP intentionally permissive for the SPA bundle; tighten once stable.
		X-Frame-Options "DENY"
	}
}
