# --- Server ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://crm:crm@localhost:5432/whatsapp_crm

# --- Redis (for BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (from Meta Developer Portal) ---
# See SETUP_META.md for how to obtain each value.
WHATSAPP_TOKEN=                          # System User permanent token
WHATSAPP_PHONE_NUMBER_ID=                # the registered number's ID
WHATSAPP_BUSINESS_ACCOUNT_ID=            # WABA ID (for template sync)
WEBHOOK_VERIFY_TOKEN=change-me-to-random-string
META_APP_SECRET=                         # for X-Hub-Signature-256 validation
META_GRAPH_VERSION=v21.0

# --- Auth (WhatsApp OTP) ---
# Approved WhatsApp template name (category: AUTHENTICATION) with one body var = the OTP code.
OTP_TEMPLATE_NAME=login_otp
OTP_TEMPLATE_LANGUAGE=en
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-32-byte-hex-secret
JWT_TTL_SECONDS=43200

# --- Bootstrap admin (used by db:seed only) ---
BOOTSTRAP_ADMIN_PHONE=+919999999999
BOOTSTRAP_ADMIN_NAME=Master Admin

# --- Outbound webhook delivery ---
WEBHOOK_DELIVERY_RETRIES=5

# --- Storage ---
# Choose 'disk' for local dev or 's3' for production
STORAGE_DRIVER=disk
DISK_STORAGE_PATH=./storage

# Only required if STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend ---
CORS_ORIGIN=http://localhost:5173
